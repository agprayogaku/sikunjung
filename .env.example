NODE_ENV=development
PORT=3000
TZ=Asia/Jakarta
# Buat nilai acak unik, contoh: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_GENERATE_RANDOM_64_HEX_CHARACTERS_FOR_SESSION
CSRF_SECRET=CHANGE_ME_GENERATE_RANDOM_64_HEX_CHARACTERS_FOR_CSRF
TRUST_PROXY=false
BASE_URL=http://localhost:3000
ADMIN_MASTER_USERNAME=master
# Password awal akun master. Wajib diganti saat login pertama.
ADMIN_MASTER_INITIAL_PASSWORD=CHANGE_ME_STRONG_PASSWORD_MIN_12_CHARS
