<%- include('../partials/header', { title: 'Pendaftaran Berhasil', active: 'register' }) %>

<div class="page-container page-container-narrow">
  <div class="surface-card p-4 p-md-5 text-center">
    <span class="success-icon lg mx-auto mb-3">
      <i class="bi bi-check-lg" aria-hidden="true"></i>
    </span>

    <h1 class="h3 fw-bold mb-2">Pendaftaran Kunjungan Berhasil</h1>
    <p class="text-muted small mb-4">
      Data Anda telah tersimpan di sistem SIKUNJUNG Lapas Kelas IIB Purwakarta.
    </p>

    <div class="surface-muted p-4 mb-4">
      <span class="section-label">Nomor registrasi pendaftaran Anda</span>
      <div class="d-flex flex-wrap align-items-center justify-content-center gap-2">
        <h2 class="display-6 fw-bold mb-0 text-primary registration-number" id="successRegNumber">
          <%= record.registrationNumber %>
        </h2>
        <button type="button" class="btn btn-outline-secondary btn-sm" data-copy="<%= record.registrationNumber %>">
          <i class="bi bi-clipboard" aria-hidden="true"></i> Salin
        </button>
      </div>
      <div class="d-flex flex-wrap justify-content-center gap-2 mt-3">
        <span class="badge badge-soft-neutral">
          <i class="bi bi-calendar3" aria-hidden="true"></i> Tanggal: <%= record.visitDate %>
        </span>
        <span class="badge badge-soft-warning">
          <i class="bi bi-hourglass-split" aria-hidden="true"></i> Status: <%= record.status %>
        </span>
      </div>
    </div>

    <div class="alert alert-info text-start">
      <i class="bi bi-megaphone-fill" aria-hidden="true"></i>
      <div>
        <strong class="d-block mb-1">Penting untuk diketahui</strong>
        <ul class="mb-0 ps-3 small">
          <li>Nomor di atas adalah <strong>Nomor Registrasi Booking</strong>, bukan nomor antrean.</li>
          <li><strong>Nomor antrean fisik</strong> (misal A 001) diterbitkan petugas saat Anda tiba dan melakukan verifikasi e-KTP asli di loket.</li>
        </ul>
      </div>
    </div>

    <div class="row g-2 text-start mb-4">
      <div class="col-12 col-sm-6">
        <div class="info-tile h-100">
          <span class="info-tile-icon"><i class="bi bi-person-vcard" aria-hidden="true"></i></span>
          <div>
            <h2 class="info-tile-title">Bawa e-KTP</h2>
            <p class="info-tile-text">Seluruh pengunjung dewasa wajib membawa e-KTP asli.</p>
          </div>
        </div>
      </div>
      <div class="col-12 col-sm-6">
        <div class="info-tile h-100">
          <span class="info-tile-icon"><i class="bi bi-clock" aria-hidden="true"></i></span>
          <div>
            <h2 class="info-tile-title">Datang tepat waktu</h2>
            <p class="info-tile-text">Ikuti sesi kunjungan sesuai jadwal yang dipilih.</p>
          </div>
        </div>
      </div>
    </div>

    <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
      <a href="/daftar/pdf/<%= record.registrationNumber %>?token=<%= encodeURIComponent(record.verifyToken) %>" class="btn btn-primary btn-lg">
        <i class="bi bi-download" aria-hidden="true"></i> Unduh bukti PDF (A6)
      </a>
      <a href="/status?reg=<%= record.registrationNumber %>&token=<%= encodeURIComponent(record.verifyToken) %>" class="btn btn-outline-secondary btn-lg">
        <i class="bi bi-search" aria-hidden="true"></i> Lihat status pendaftaran
      </a>
    </div>

    <div class="mt-4 pt-3 border-top">
      <a href="/" class="small text-muted">
        <i class="bi bi-arrow-left" aria-hidden="true"></i> Kembali ke halaman utama
      </a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
