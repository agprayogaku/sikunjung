<div class="admin-sidebar-footer">
  <div class="admin-user">
    <span class="admin-user-avatar" aria-hidden="true"><%= typeof adminUser !== 'undefined' && adminUser ? adminUser.username.slice(0, 2) : 'SP' %></span>
    <div class="min-w-0">
      <span class="admin-user-name"><%= typeof adminUser !== 'undefined' && adminUser ? adminUser.username : 'Petugas' %></span>
      <span class="admin-user-role"><%= typeof adminUser !== 'undefined' && adminUser ? adminUser.role : 'ADMIN' %></span>
    </div>
  </div>
  <div class="d-flex align-items-center gap-2 mt-2">
    <button type="button" class="theme-toggle-btn" aria-label="Aktifkan tema gelap" aria-pressed="false" title="Ganti tema">
      <i class="theme-icon bi bi-moon-stars" aria-hidden="true"></i>
      <span class="theme-text">Tema Gelap</span>
    </button>
    <form action="/admin/logout" method="POST" class="flex-grow-1">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="btn btn-outline-secondary btn-sm w-100">
        <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
        <span>Keluar</span>
      </button>
    </form>
