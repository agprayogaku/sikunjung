<%- include('./partials/adminHeader', { title: title || 'Kesalahan', active: '' }) %>

<div class="d-flex align-items-center justify-content-center py-5">
  <div class="surface-card p-4 p-md-5 text-center error-card">
    <span class="icon-square danger icon-square-lg mx-auto mb-3">
      <i class="bi bi-shield-x" aria-hidden="true"></i>
    </span>

    <h2 class="h4 fw-bold mb-2"><%= typeof title !== 'undefined' ? title : 'Akses Ditolak' %></h2>
    <p class="text-muted small mb-4">
      <%= typeof message !== 'undefined' ? message : 'Anda tidak memiliki hak akses untuk membuka halaman ini.' %>
    </p>

    <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
      <a href="/admin/dashboard" class="btn btn-primary">
        <i class="bi bi-speedometer2" aria-hidden="true"></i> Kembali ke Dashboard
      </a>
      <form action="/admin/logout" method="POST" class="d-inline">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn btn-outline-secondary">
          <i class="bi bi-box-arrow-right" aria-hidden="true"></i> Keluar
        </button>
      </form>
    </div>
  </div>
</div>

<%- include('./partials/adminFooter') %>
