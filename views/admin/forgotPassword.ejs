<%- include('../partials/authHeader', {
  title: 'Lupa Password',
  authTitle: 'Pengajuan Reset Password',
  authSubtitle: 'Ajukan reset password akun petugas.'
}) %>

<% if (typeof success !== 'undefined' && success) { %>
  <div class="alert alert-success" role="alert">
    <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
    <span><%= success %></span>
  </div>
<% } %>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="alert alert-danger" role="alert">
    <i class="bi bi-exclamation-octagon-fill" aria-hidden="true"></i>
    <span><%= error %></span>
  </div>
<% } %>

<div class="alert alert-info small">
  <i class="bi bi-info-circle-fill" aria-hidden="true"></i>
  <span>Password sementara hanya dapat dibuat oleh Administrator Master setelah permintaan disetujui.</span>
</div>

<form action="/admin/lupa-password" method="POST">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="mb-3">
    <label class="form-label" for="username">Username akun petugas</label>
    <input type="text" id="username" name="username" class="form-control" placeholder="Contoh: admin_loket_1" autocomplete="username" required autofocus>
  </div>

  <button type="submit" class="btn btn-primary w-100">
    <i class="bi bi-send" aria-hidden="true"></i> Kirim permintaan reset
  </button>
</form>

<div class="auth-footer">
  <a href="/admin/login" class="text-muted">
    <i class="bi bi-arrow-left" aria-hidden="true"></i> Kembali ke halaman login
  </a>
</div>

<%- include('../partials/authFooter') %>
